  author = {{Mart{\'i}nez-Plumed}, Fernando and {Contreras-Ochando}, Lidia and Ferri, C{\`e}sar and {Hern{\'a}ndez-Orallo}, Jos{\'e} and Kull, Meelis and Lachiche, Nicolas and {Ram{\'i}rez-Quintana}, Mar{\'i}a Jos{\'e} and Flach, Peter},
